<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de cobertura (Métrica 1.1). Se mide la lógica de negocio y persistencia;
     la capa de consola (interfaz) y el código generado quedan fuera. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Exclude>[Pos.ConsoleApp]*,[Pos.Tests]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
